// CoreTask database schema
// ---------------------------------------------------------------------------
// Conventions
//   * Primary keys are UUID v7 (`@default(uuid(7))`). They are time-ordered, so
//     they index like a sequence while staying unguessable. Sequential integer
//     ids are never exposed.
//   * Every workspace-owned table carries `workspaceId` directly — even when the
//     relationship could be derived through a parent — so that a tenant filter
//     is always one indexed column away and can never be forgotten.
//   * Soft deletion is used only where history matters (`archivedAt` on
//     workspace/project/task, `deletedAt` on comment). Everything else is
//     deleted for real.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

/// The types a project may default to, which is exactly the types that can be
/// created. Milestone and Approval exist in the shared contract so the picker
/// can show them as coming; a project defaulting to one would render a button
/// that fails on click.
enum CreatableWorkItemType {
  TASK
  TICKET
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Who can see a project. `PUBLIC` is every member of the workspace — the
/// behaviour every project had before privacy existed, and still the default.
/// `PRIVATE` is the project's own members plus the workspace's admins.
enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

/// A member's standing inside one project. It can only *lower* what the
/// workspace role allows: an EDITOR acts as at most a workspace MEMBER, a
/// VIEWER as at most a GUEST, and an ADMIN keeps their workspace role and may
/// also manage the roster and the project's privacy.
enum ProjectMemberRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum TicketType {
  BUG
  FEATURE
  SUPPORT
  QUESTION
  MAINTENANCE
  INCIDENT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  COMMENT_CREATED
  MENTIONED
  WORKSPACE_INVITE
  /// A collaborator's task or ticket changed in a way worth telling them about
  /// (due date), short of completion, which keeps its own type above.
  TASK_UPDATED
  TICKET_UPDATED
  /// A custom field flagged "notify collaborators" changed value.
  FIELD_CHANGED
  /// Someone added you to a project's members.
  PROJECT_MEMBER_ADDED
  /// A status update or a message was posted in a project you are on, or a
  /// message you are part of got a reply.
  PROJECT_UPDATE
}

/// What happened. A story's kind is what the audit trail and the task panel's
/// activity feed key on, so it is a value here rather than a tag hidden in
/// `metadata` — the feed can be queried by it.
enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  RESTORED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  COMMENTED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  FIELD_CHANGED
  ATTACHED
  DETACHED
  FOLLOWED
  UNFOLLOWED
  SUBTASK_ADDED
  PINNED
  UNPINNED
}

enum AttachmentStatus {
  PENDING
  READY
}

enum ActivityEntity {
  WORKSPACE
  WORKSPACE_MEMBER
  PROJECT
  SECTION
  TASK
  TICKET
  COMMENT
  TEAM
  ATTACHMENT
  USER
  API_KEY
  WEBHOOK_ENDPOINT
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased; the application normalises before writing.
  email            String    @unique @db.VarChar(254)
  passwordHash     String
  name             String    @db.VarChar(120)
  avatarUrl        String?
  timezone         String    @default("UTC") @db.VarChar(64)
  /// The profile: shown on member lists and beside a name in pickers.
  pronouns         String?   @db.VarChar(40)
  jobTitle         String?   @db.VarChar(80)
  department       String?   @db.VarChar(80)
  aboutMe          String?
  /// Time off, calendar days both inclusive; both set or both null.
  outOfOfficeFrom  DateTime? @db.Date
  outOfOfficeUntil DateTime? @db.Date
  outOfOfficeNote  String?   @db.VarChar(200)
  emailVerifiedAt  DateTime?
  isActive         Boolean   @default(true)
  /// True for the hidden principal behind an API key. It never signs in, never
  /// receives mail (its address is under a reserved TLD) and is left out of
  /// people lists and counts — every query that lists members must filter it.
  isServiceAccount Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens              RefreshToken[]
  apiKey                     ApiKey?
  createdApiKeys             ApiKey[]                 @relation("ApiKeyCreatedBy")
  createdWebhookEndpoints    WebhookEndpoint[]        @relation("WebhookEndpointCreatedBy")
  oauthApps                  OAuthApp[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  oauthCodes                 OAuthAuthorizationCode[]
  oauthGrants                OAuthGrant[]
  memberships                WorkspaceMember[]
  invitedMembers             WorkspaceMember[]        @relation("MemberInvitedBy")
  createdWorkspaces          Workspace[]              @relation("WorkspaceCreatedBy")
  ledProjects                Project[]                @relation("ProjectLead")
  projectMemberships         ProjectMember[]          @relation("ProjectMemberships")
  projectMembersAdded        ProjectMember[]          @relation("ProjectMemberAddedBy")
  createdTasks               Task[]                   @relation("TaskCreatedBy")
  assignedTasks              Task[]                   @relation("TaskAssignee")
  reportedTickets            Ticket[]                 @relation("TicketReporter")
  assignedTickets            Ticket[]                 @relation("TicketAssignee")
  comments                   Comment[]
  attachments                Attachment[]
  mentionedIn                CommentMention[]
  commentLikes               CommentLike[]
  pinnedComments             Comment[]                @relation("CommentPinnedBy")
  following                  Follower[]
  taskLikes                  TaskLike[]
  starredProjects            ProjectStar[]
  projectStatusUpdates       ProjectStatusUpdate[]
  ownedPortfolios            Portfolio[]              @relation("PortfolioOwner")
  portfolioStars             PortfolioStar[]
  projectMessages            ProjectMessage[]
  projectMessageReplies      ProjectMessageReply[]
  myTaskPlacements           MyTaskPlacement[]
  ownedGoals                 Goal[]                   @relation("GoalOwner")
  createdGoals               Goal[]                   @relation("GoalCreatedBy")
  createdDependencies        TaskDependency[]         @relation("DependencyCreatedBy")
  sentInvitations            WorkspaceInvitation[]    @relation("InvitationSentBy")
  approvedOAuthApps          WorkspaceOAuthApp[]      @relation("OAuthAppApprovedBy")
  teamMemberships            TeamMember[]
  ledTeams                   Team[]                   @relation("TeamLead")
  activityLogs               ActivityLog[]
  notifications              Notification[]
  createdFields              CustomField[]            @relation("CustomFieldCreatedBy")
  updatedFieldValues         TaskCustomFieldValue[]   @relation("CustomFieldValueUpdatedBy")
  ownedViews                 ProjectView[]            @relation("ProjectViewOwner")
  createdViews               ProjectView[]            @relation("ProjectViewCreatedBy")
  createdAutomations         AutomationRule[]         @relation("AutomationCreatedBy")
  createdAutomationVersions  AutomationRuleVersion[]  @relation("AutomationVersionCreatedBy")
  createdAutomationTemplates AutomationTemplate[]     @relation("AutomationTemplateCreatedBy")
  portfolioMessages          PortfolioMessage[]       @relation("PortfolioMessageAuthor")
  portfolioStatusUpdates     PortfolioStatusUpdate[]  @relation("PortfolioStatusAuthor")
  teamMessages               TeamMessage[]            @relation("TeamMessageAuthor")
  projectNotesEdited         ProjectNote[]            @relation("ProjectNoteEditor")
  goalUpdates                GoalUpdate[]             @relation("GoalUpdateAuthor")
  notificationPreferences    NotificationPreference[]
  projectResourcesAdded      ProjectResource[]        @relation("ProjectResourceCreator")
  teamMessageReplies         TeamMessageReply[]       @relation("TeamMessageReplyAuthor")
  portfolioCapacities        PortfolioCapacity[]      @relation("PortfolioCapacityUser")
  homeLayouts                HomeLayout[]
  reportDashboards           ReportDashboard[]        @relation("ReportDashboardOwner")
  savedSearches              SavedSearch[]
  calendarFeeds              CalendarFeed[]
  tagsCreated                Tag[]                    @relation("TagCreatedBy")
  projectTemplates           ProjectTemplate[]        @relation("ProjectTemplateCreator")
  portfolioMessageReplies    PortfolioMessageReply[]  @relation("PortfolioMessageReplyAuthor")
  timeEntries                TimeEntry[]              @relation("TimeEntryUser")

  @@index([isActive])
  @@map("users")
}

/// One row per issued refresh token. Rotation writes a new row and revokes the
/// previous one, so `sessionId` identifies a token *family* and lets a replayed
/// token take the whole family down.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// Stable across rotations — one browser/device session.
  sessionId    String    @db.Uuid
  /// SHA-256 of the token. High-entropy secrets do not need a slow KDF; the
  /// hash exists so a database leak cannot be replayed.
  tokenHash    String    @unique @db.VarChar(64)
  /// Rotation counter, incremented on every refresh.
  version      Int       @default(1)
  userAgent    String?   @db.VarChar(400)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A workspace API key: the credential a tool such as n8n presents.
///
/// The key acts as a hidden service-account `User` (`isServiceAccount`) whose
/// `WorkspaceMember` row carries the role, so every createdBy/author foreign
/// key and the membership guard keep working unchanged. Only the SHA-256 of the
/// key is stored; the raw value is shown once at creation. Revoking keeps the
/// rows so "created by n8n" stays true in the history.
model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  /// The service account this key acts as. One key, one account.
  userId      String    @unique @db.Uuid
  name        String    @db.VarChar(80)
  /// `ctk_` plus the first characters of the random part — for the list, never for lookup.
  prefix      String    @db.VarChar(16)
  /// SHA-256 hex of the raw key.
  tokenHash   String    @unique @db.VarChar(64)
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  webhookEndpoints WebhookEndpoint[]

  @@index([workspaceId, revokedAt])
  @@map("api_keys")
}

/// An app a developer registered so other tools can act for CoreTask users
/// (OAuth 2.0, authorization-code flow). Owned by the person who registered it.
model OAuthApp {
  id               String   @id @default(uuid(7)) @db.Uuid
  ownerId          String   @db.Uuid
  name             String   @db.VarChar(80)
  description      String?  @db.VarChar(500)
  websiteUrl       String?  @db.VarChar(2048)
  /// Matched exactly at authorization: the only places a code can be sent.
  redirectUris     String[]
  /// `ctc_…`, public.
  clientId         String   @unique @db.VarChar(64)
  /// A public client (mobile, desktop) has no secret: it proves itself with
  /// PKCE, and its refresh tokens rotate. Fixed when the app is registered.
  isPublic         Boolean  @default(false)
  /// SHA-256 hex of the `cts_…` secret.
  clientSecretHash String?  @db.VarChar(64)
  /// `cts_` plus the first characters — for the list, never for lookup.
  secretHint       String?  @db.VarChar(16)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner      User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  codes      OAuthAuthorizationCode[]
  grants     OAuthGrant[]
  workspaces WorkspaceOAuthApp[]

  @@index([ownerId])
  @@map("oauth_apps")
}

/// Whether a workspace lets in any OAuth app its members connect, or only the
/// ones its admins put in its app directory.
enum OAuthAppPolicy {
  ANY
  APPROVED
}

/// An OAuth app a workspace's admins approved: its app directory. Under the
/// APPROVED policy, an app's tokens act in the workspace only while it is here.
model WorkspaceOAuthApp {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @db.Uuid
  appId        String   @db.Uuid
  approvedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  app        OAuthApp  @relation(fields: [appId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("OAuthAppApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, appId])
  @@index([appId])
  @@map("workspace_oauth_apps")
}

/// A code handed to an app's redirect URI, good once, for a few minutes.
model OAuthAuthorizationCode {
  id            String    @id @default(uuid(7)) @db.Uuid
  appId         String    @db.Uuid
  userId        String    @db.Uuid
  /// SHA-256 hex of the code.
  codeHash      String    @unique @db.VarChar(64)
  redirectUri   String    @db.VarChar(2048)
  scopes        String[]
  /// PKCE (S256), when the app sent a challenge.
  codeChallenge String?   @db.VarChar(128)
  expiresAt     DateTime
  usedAt        DateTime?
  /// The grant the code was exchanged for, so a replayed code can revoke it.
  grantId       String?   @db.Uuid
  createdAt     DateTime  @default(now())

  app  OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

/// One person's authorization of one app. Holds the refresh token; revoking it
/// ends every access token issued under it and the webhooks it subscribed.
model OAuthGrant {
  id               String    @id @default(uuid(7)) @db.Uuid
  appId            String    @db.Uuid
  userId           String    @db.Uuid
  scopes           String[]
  /// SHA-256 hex of the `ctr_…` refresh token.
  refreshTokenHash String    @unique @db.VarChar(64)
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  app              OAuthApp           @relation(fields: [appId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens     OAuthAccessToken[]
  webhookEndpoints WebhookEndpoint[]

  @@index([userId, revokedAt])
  @@index([appId, revokedAt])
  @@map("oauth_grants")
}

/// A `cto_…` access token: an hour, then the app refreshes.
model OAuthAccessToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  grantId   String   @db.Uuid
  /// SHA-256 hex of the token.
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, expiresAt])
  @@map("oauth_access_tokens")
}

// ---------------------------------------------------------------------------
// Integrations — outbound webhooks
// ---------------------------------------------------------------------------

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A URL an admin registered to be told when things happen in the workspace.
/// The signing secret is stored encrypted (AES-256-GCM, see lib/secret-cipher.ts)
/// because signing needs it back — a hash would not do — and is never listed.
model WebhookEndpoint {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  workspaceId         String                 @db.Uuid
  name                String                 @db.VarChar(80)
  url                 String                 @db.VarChar(2048)
  /// `v1.<iv>.<tag>.<ciphertext>`, base64url parts.
  secret              String
  /// WebhookEventType values the endpoint subscribed to.
  events              String[]
  /// Null means every project in the workspace.
  projectId           String?                @db.Uuid
  /// SLACK, TEAMS, GOOGLE_CHAT or DISCORD: a project's chat app (Customize ›
  /// Apps), posted as that tool's message format. Null for a plain webhook.
  /// An app is only ever its project's: with the project gone, it is silent.
  app                 String?                @db.VarChar(16)
  enabled             Boolean                @default(true)
  /// Set when the endpoint switched itself off after too many failed deliveries.
  disabledReason      String?                @db.VarChar(200)
  consecutiveFailures Int                    @default(0)
  lastDeliveryAt      DateTime?
  lastDeliveryStatus  WebhookDeliveryStatus?
  lastSuccessAt       DateTime?
  createdById         String?                @db.Uuid
  /// Subscribed through the API by this API key — gone with the key.
  apiKeyId            String?                @db.Uuid
  /// Subscribed through the API by an OAuth app — gone when it is disconnected.
  oauthGrantId        String?                @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  apiKey     ApiKey?           @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  oauthGrant OAuthGrant?       @relation(fields: [oauthGrantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, enabled])
  @@index([apiKeyId])
  @@index([oauthGrantId])
  @@map("webhook_endpoints")
}

/// One event to one endpoint, updated per attempt. The payload is stored as
/// sent so every retry signs the identical bytes; `attempts` keeps the history.
model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  workspaceId    String                @db.Uuid
  /// Null when a rule sent to an ad-hoc URL rather than a registered endpoint.
  endpointId     String?               @db.Uuid
  ruleId         String?               @db.Uuid
  eventType      String                @db.VarChar(60)
  /// Stable across attempts and endpoints — the receiver's idempotency key.
  eventId        String                @db.Uuid
  correlationId  String?               @db.Uuid
  /// Snapshot: the endpoint may be edited later.
  url            String                @db.VarChar(2048)
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempt        Int                   @default(0)
  maxAttempts    Int
  responseStatus Int?
  responseBody   String?               @db.VarChar(500)
  error          String?               @db.VarChar(500)
  durationMs     Int?
  /// [{ at, succeeded, responseStatus, error, durationMs }]
  attempts       Json                  @default("[]")
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  rule      AutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([eventId, endpointId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([ruleId])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Workspace {
  id            String  @id @default(uuid(7)) @db.Uuid
  name          String  @db.VarChar(80)
  slug          String  @unique @db.VarChar(40)
  description   String?
  logoUrl       String?
  /// Prefix for human-readable ticket keys, e.g. `CORE` -> `CORE-1001`.
  ticketPrefix  String  @default("CORE") @db.VarChar(8)
  /// Last issued ticket number. Incremented inside the ticket-creation
  /// transaction so keys stay gapless and collision-free.
  ticketCounter Int     @default(1000)

  createdById    String         @db.Uuid
  /// Which OAuth apps may act in this workspace: any a member connects, or
  /// only those in its app directory (`WorkspaceOAuthApp`).
  oauthAppPolicy OAuthAppPolicy @default(ANY)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdBy               User                     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  apiKeys                 ApiKey[]
  webhookEndpoints        WebhookEndpoint[]
  oauthApps               WorkspaceOAuthApp[]
  webhookDeliveries       WebhookDelivery[]
  teams                   Team[]
  projects                Project[]
  projectMembers          ProjectMember[]
  sections                Section[]
  tasks                   Task[]
  taskDependencies        TaskDependency[]
  goals                   Goal[]
  portfolios              Portfolio[]
  tickets                 Ticket[]
  comments                Comment[]
  attachments             Attachment[]
  followers               Follower[]
  activityLogs            ActivityLog[]
  notifications           Notification[]
  statuses                StatusDefinition[]
  priorities              PriorityDefinition[]
  customFields            CustomField[]
  projectViews            ProjectView[]
  automationRules         AutomationRule[]
  automationExecutions    AutomationExecution[]
  automationTemplates     AutomationTemplate[]
  bundles                 Bundle[]
  homeLayouts             HomeLayout[]
  reportDashboards        ReportDashboard[]
  savedSearches           SavedSearch[]
  calendarFeeds           CalendarFeed[]
  notificationPreferences NotificationPreference[]
  tags                    Tag[]
  projectTemplates        ProjectTemplate[]

  @@index([createdById])
  @@index([archivedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(uuid(7)) @db.Uuid
  workspaceId  String        @db.Uuid
  userId       String        @db.Uuid
  role         WorkspaceRole @default(MEMBER)
  invitedById  String?       @db.Uuid
  /// The person's My Tasks auto-sort rules here; contracts' `myTasksRulesOf` fills gaps.
  myTasksRules Json          @default("{}")
  joinedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

/// A pending offer of membership, addressed to an e-mail rather than a user —
/// the point is to invite people who have not signed up yet.
///
/// Only the SHA-256 of the token is stored, for the same reason as refresh
/// tokens: the raw value goes out in one e-mail link and a database leak must
/// not be replayable. There is no way to re-read a token, so "resend" issues a
/// new one.
///
/// Unique per workspace and e-mail: re-inviting the same address refreshes this
/// row rather than stacking up offers, which also makes "resend" and "change the
/// role before they accept" the same operation.
model WorkspaceInvitation {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @db.Uuid
  /// Lower-cased on write so the unique constraint is case-insensitive.
  email       String             @db.VarChar(254)
  role        WorkspaceRole      @default(MEMBER)
  tokenHash   String             @unique
  invitedById String?            @db.Uuid
  /// Team to join on acceptance. Optional — most invitations name no team.
  /// `SetNull` on purpose: deleting a team must not invalidate a live
  /// invitation, because the workspace membership is the part that matters and
  /// the team was only ever a convenience.
  teamId      String?            @db.Uuid
  /// Project to join on acceptance, from a project's Share dialog, with the
  /// role to hold there. `SetNull` for the team's reason: a deleted project
  /// still leaves the workspace invitation worth accepting.
  projectId   String?            @db.Uuid
  projectRole ProjectMemberRole?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: SetNull)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId, acceptedAt])
  @@index([teamId])
  @@index([projectId])
  @@map("workspace_invitations")
}

// ---------------------------------------------------------------------------
// Work items
// ---------------------------------------------------------------------------

model Project {
  id                  String                @id @default(uuid(7)) @db.Uuid
  workspaceId         String                @db.Uuid
  name                String                @db.VarChar(120)
  /// Short uppercase code, unique within the workspace.
  key                 String                @db.VarChar(8)
  description         String?
  status              ProjectStatus         @default(PLANNING)
  color               String                @default("#6366F1") @db.VarChar(9)
  /// What the "+ Add" control creates without being asked. Backfilled from
  /// each project's own mix of tasks and tickets — see the migration.
  defaultWorkItemType CreatableWorkItemType @default(TASK)
  /// Who can open it. See `ProjectVisibility`; `members` is the list a
  /// private project is private *to*.
  visibility          ProjectVisibility     @default(PUBLIC)
  leadId              String?               @db.Uuid
  startDate           DateTime?
  dueDate             DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  /// Which team owns this project. Optional: plenty of work belongs to the
  /// workspace at large, and a project outlives the team that started it.
  teamId String? @db.Uuid

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead             User?                 @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  team             Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  invitations      WorkspaceInvitation[]
  statusDraft      ProjectStatusDraft?
  stars            ProjectStar[]
  statusUpdates    ProjectStatusUpdate[]
  portfolios       PortfolioProject[]
  statusTemplates  StatusTemplate[]
  bundles          BundleProject[]
  bundlesMade      Bundle[]              @relation("BundleSource")
  taskTemplates    TaskTemplate[]
  forms            ProjectForm[]
  emailInbox       ProjectEmailInbox?
  note             ProjectNote?
  calendarFeeds    CalendarFeed[]
  resources        ProjectResource[]
  inboundEmails    InboundEmail[]
  messages         ProjectMessage[]
  goals            GoalProject[]
  sections         Section[]
  tasks            Task[]
  tickets          Ticket[]
  statuses         StatusDefinition[]
  customFields     ProjectCustomField[]
  views            ProjectView[]
  automations      AutomationRule[]
  webhookEndpoints WebhookEndpoint[]
  activityLogs     ActivityLog[]
  /// Templates saved from this project's rules. Informational — a template
  /// outlives the project, which is why the link nulls rather than cascades.
  savedTemplates   AutomationTemplate[]  @relation("TemplateSourceProject")
  taskLinks        TaskProject[]         @relation("TaskProjectLinks")

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, visibility])
  @@index([leadId])
  @@index([workspaceId, teamId])
  @@map("projects")
}

/// A project someone has starred — Asana's sidebar favourites.
///
/// Per person, not per project: starring is a bookmark, so it changes nothing
/// anyone else sees. `position` is fractional, so the sidebar list can be
/// reordered by writing one row. Visibility is not stored here; a star on a
/// project that later turns private is simply not listed for whoever lost
/// access, and comes back if they regain it.
model ProjectStar {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  position  Float    @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, position])
  @@map("project_stars")
}

/// An intake form — Asana's Forms: a public page anyone with the link can fill
/// in, each submission becoming a task in the project.
model ProjectForm {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  /// The unguessable part of the public link.
  token           String   @unique @db.VarChar(64)
  /// Off, the link answers "this form is closed".
  isActive        Boolean  @default(true)
  /// Where submissions land; the project's first section when null.
  sectionId       String?  @db.Uuid
  /// `{ id, label, kind, required }[]`, asked after the title and details.
  questions       Json     @default("[]")
  createdById     String?  @db.Uuid
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_forms")
}

/// A task template — Asana's "Task types and templates": a ready-made task,
/// with its subtasks, that the project's Add menu can create in one step.
model TaskTemplate {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  projectId   String        @db.Uuid
  /// What the template is called in the menu.
  name        String        @db.VarChar(120)
  /// The title the created task gets.
  title       String        @db.VarChar(500)
  description String?
  kind        TaskKind      @default(TASK)
  priority    TaskPriority?
  assigneeId  String?       @db.Uuid
  /// Due this many days after it is created; null for no due date.
  dueInDays   Int?
  /// `{ title, assigneeId? }[]`, created as subtasks in this order.
  subtasks    Json          @default("[]")
  createdById String?       @db.Uuid
  /// Set when a bundle wrote this template; the bundle replaces it on refresh.
  bundleId    String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bundle  Bundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("task_templates")
}

/// A named set of projects watched together — Asana's portfolios.
///
/// Workspace-wide: everyone in the workspace sees it, and what each person
/// sees inside it is filtered by project visibility. Stars are per person.
model Portfolio {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  color           String   @db.VarChar(7)
  ownerId         String?  @db.Uuid
  /// Workload: TASKS (open tasks) or HOURS (summed estimates).
  workloadMeasure String   @default("TASKS") @db.VarChar(10)
  /// Everyone's capacity unless set per person; null for none.
  defaultCapacity Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User?                   @relation("PortfolioOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projects      PortfolioProject[]
  stars         PortfolioStar[]
  messages      PortfolioMessage[]
  capacities    PortfolioCapacity[]
  statusUpdates PortfolioStatusUpdate[]

  @@index([workspaceId])
  @@map("portfolios")
}

model PortfolioProject {
  portfolioId String   @db.Uuid
  projectId   String   @db.Uuid
  position    Float    @default(0)
  addedAt     DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([portfolioId, projectId])
  @@index([projectId])
  @@map("portfolio_projects")
}

/// A message on a portfolio's Messages tab — a conversation across its projects.
model PortfolioMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  portfolioId String   @db.Uuid
  authorId    String?  @db.Uuid
  title       String   @db.VarChar(200)
  /// Sanitised rich text, as a project message is stored.
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio Portfolio               @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  author    User?                   @relation("PortfolioMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  replies   PortfolioMessageReply[]

  @@index([portfolioId, createdAt])
  @@map("portfolio_messages")
}

/// A team's Messages tab: conversations for the team as a whole.
model TeamMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  teamId      String   @db.Uuid
  authorId    String?  @db.Uuid
  title       String   @db.VarChar(200)
  /// Sanitised rich text, like a project message.
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team    Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author  User?              @relation("TeamMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  replies TeamMessageReply[]

  @@index([teamId, createdAt])
  @@map("team_messages")
}

model TeamMessageReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  message TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User?       @relation("TeamMessageReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@map("team_message_replies")
}

model PortfolioMessageReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  message PortfolioMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User?            @relation("PortfolioMessageReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@map("portfolio_message_replies")
}

/// One person's capacity in a portfolio, where it differs from the default.
model PortfolioCapacity {
  portfolioId String @db.Uuid
  userId      String @db.Uuid
  capacity    Int

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation("PortfolioCapacityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([portfolioId, userId])
  @@map("portfolio_capacities")
}

/// One person's Home in one workspace: the widgets it shows, in order, and
/// their private notepad.
model HomeLayout {
  userId      String   @db.Uuid
  workspaceId String   @db.Uuid
  widgets     String[]
  notepad     String   @default("")
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("home_layouts")
}

/// A report dashboard — Asana's Reporting. Shared with the workspace; its
/// charts are questions, answered for each reader when drawn.
/// A tag — Asana's workspace-wide label. `nameKey` is the lowercase,
/// single-spaced name, unique per workspace, so "Urgent" and "urgent" are one.
model Tag {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(60)
  nameKey     String   @db.VarChar(60)
  /// A colour token (contracts' colors.ts).
  color       String   @default("gray") @db.VarChar(20)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     TaskTag[]

  @@unique([workspaceId, nameKey])
  @@map("tags")
}

/// A tag on a task.
model TaskTag {
  taskId    String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

/// Which notifications someone also gets by email, per workspace — Asana's
/// Settings › Notifications. No row means the defaults (assignments, mentions).
model NotificationPreference {
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  /// NotificationEmailGroup values (contracts' notification-emails.ts).
  emailGroups String[]
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("notification_preferences")
}

/// A search someone kept — Asana's saved searches. The filters are
/// `TaskSearchFilters` (contracts' saved-searches.ts); "me" in them is
/// whoever runs it, which is always the person who saved it.
model SavedSearch {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  name        String   @db.VarChar(80)
  filters     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("saved_searches")
}

model ReportDashboard {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(120)
  ownerId     String?  @db.Uuid
  /// `ReportChart[]` — see contracts' reports.ts.
  charts      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation("ReportDashboardOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("report_dashboards")
}

/// A project template — a blueprint any number of projects start from, their
/// task dates counted from the day each starts.
model ProjectTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  color           String   @db.VarChar(7)
  /// Which of tasks, subtasks, dates, fields, rules… it carries.
  parts           String[]
  /// The blueprint itself — see project-templates' blueprint.ts.
  blueprint       Json
  sourceProjectId String?  @db.Uuid
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ProjectTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("project_templates")
}

model PortfolioStar {
  portfolioId String   @db.Uuid
  userId      String   @db.Uuid
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([portfolioId, userId])
  @@index([userId])
  @@map("portfolio_stars")
}

/// What kind of task a task is. See `task-kinds.ts` in contracts.
enum TaskKind {
  TASK
  MILESTONE
  APPROVAL
}

/// An approval's answer. Approving or rejecting completes it; requesting
/// changes sends it back open.
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/// Asana's project status colours. A person's judgement of how the work is
/// going, never derived from it.
enum ProjectStatusValue {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ON_HOLD
  COMPLETE
  DROPPED
}

/// A posted status update — "On track", with a summary and next steps.
///
/// Kept as a history rather than one current value: the project's status is
/// its newest update, and the older ones are what the Messages tab and the
/// Overview read back. Never edited after posting, as in Asana; a wrong one is
/// deleted and posted again.
model ProjectStatusUpdate {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @db.Uuid
  projectId   String             @db.Uuid
  authorId    String?            @db.Uuid
  status      ProjectStatusValue
  title       String             @db.VarChar(200)
  summary     String?
  nextSteps   String?
  createdAt   DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_status_updates")
}

/// A status update a rule's "Draft an update with AI…" step wrote, waiting
/// for a person to review and post it. One per project: a newer draft
/// replaces it, and posting any update clears it — the project has a fresher
/// word on itself by then.
model ProjectStatusDraft {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @db.Uuid
  projectId   String             @unique @db.Uuid
  ruleId      String?            @db.Uuid
  status      ProjectStatusValue
  title       String             @db.VarChar(200)
  summary     String?
  nextSteps   String?
  createdAt   DateTime           @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule    AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@map("project_status_drafts")
}

/// A package of a project's workflow — Customize › Bundles. Its sections and
/// fields are added to every project it is applied to; its rules and task
/// templates are written into each, tagged, and replaced when it changes.
model Bundle {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  /// The project it was made from, and is refreshed from.
  sourceProjectId String?  @db.Uuid
  /// Section names, in board order.
  sections        Json     @default("[]")
  /// Workspace library fields, attached where the project lacks them.
  customFieldIds  String[] @db.Uuid
  /// Rule snapshots — the shape the rule library keeps.
  rules           Json     @default("[]")
  /// Task template snapshots, without ids.
  taskTemplates   Json     @default("[]")
  /// Which of sections, fields, rules and task templates it carries.
  parts           String[] @default(["SECTIONS", "FIELDS", "RULES", "TASK_TEMPLATES"])
  /// Bumped on every refresh, so a project can tell it is behind.
  version         Int      @default(1)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceProject Project?         @relation("BundleSource", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  projects      BundleProject[]
  rulesWritten  AutomationRule[]
  templates     TaskTemplate[]

  @@index([workspaceId])
  @@map("bundles")
}

/// A project a bundle is applied to, and the version it last took.
model BundleProject {
  bundleId       String   @db.Uuid
  projectId      String   @db.Uuid
  appliedVersion Int
  appliedAt      DateTime @default(now())

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([bundleId, projectId])
  @@index([projectId])
  @@map("bundle_projects")
}

/// A status update's starting point — Customize › Status templates.
model StatusTemplate {
  id          String              @id @default(uuid(7)) @db.Uuid
  workspaceId String              @db.Uuid
  projectId   String              @db.Uuid
  name        String              @db.VarChar(120)
  /// The status the composer starts on; null keeps the one picked.
  status      ProjectStatusValue?
  summary     String?
  nextSteps   String?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("status_templates")
}

/// A message posted to a project — Asana's Messages tab — with its replies.
model ProjectMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  authorId    String?  @db.Uuid
  title       String   @db.VarChar(200)
  /// Sanitised rich text, as a task description is stored.
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies ProjectMessageReply[]

  @@index([projectId, createdAt])
  @@map("project_messages")
}

model ProjectMessageReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  message ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@map("project_message_replies")
}

/// My Tasks' sections, per person: Asana's Recently assigned / Do today /
/// Do next week / Do later.
enum MyTasksBucket {
  RECENTLY_ASSIGNED
  TODAY
  NEXT_WEEK
  LATER
}

/// Where a task sits in one person's My Tasks.
///
/// Personal and separate from the task, so moving something to "Do today"
/// changes nothing anyone else sees. No row means "Recently assigned" — new
/// work needs no write to appear there. Keyed by person and task, so a task
/// sits in exactly one of someone's sections.
model MyTaskPlacement {
  userId    String        @db.Uuid
  taskId    String        @db.Uuid
  bucket    MyTasksBucket
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([taskId])
  @@map("my_task_placements")
}

enum GoalStatus {
  NO_STATUS
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  PARTIAL
  MISSED
  DROPPED
}

enum GoalProgressSource {
  MANUAL
  SUB_GOALS
  PROJECTS
  METRIC
}

/// Asana's goals: what the work is for.
///
/// A tree through `parentId` — company goals over team goals over the rest —
/// with no depth limit, and the service refuses a parent that would make a
/// goal its own ancestor. Progress is stored only for a MANUAL goal; one that
/// rolls up its sub-goals or connected projects is worked out on read, so it
/// can never go stale. Deleting a goal is a soft archive, and its sub-goals
/// move up to its parent rather than disappearing with it.
model Goal {
  id             String             @id @default(uuid(7)) @db.Uuid
  workspaceId    String             @db.Uuid
  parentId       String?            @db.Uuid
  name           String             @db.VarChar(200)
  description    String?
  status         GoalStatus         @default(NO_STATUS)
  progressSource GoalProgressSource @default(MANUAL)
  /// 0–100; read only when `progressSource` is MANUAL.
  progress       Int                @default(0)
  /// For METRIC: the number it starts at, has reached, and aims for.
  metricStart    Float?
  metricCurrent  Float?
  metricTarget   Float?
  metricUnit     String?            @db.VarChar(16)
  ownerId        String?            @db.Uuid
  teamId         String?            @db.Uuid
  timePeriod     String?            @db.VarChar(32)
  dueDate        DateTime?
  position       Float              @default(0)
  createdById    String             @db.Uuid
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Goal?         @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Goal[]        @relation("GoalTree")
  owner     User?         @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User          @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  team      Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projects  GoalProject[]
  updates   GoalUpdate[]

  @@index([workspaceId, archivedAt])
  @@index([parentId])
  @@map("goals")
}

/// A project connected to a goal — its completion can feed the goal's progress.
/// A goal's status update — Asana's goal check-in: a status, a note, and the
/// progress at the time. The newest sets the goal's status.
model GoalUpdate {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @db.Uuid
  goalId      String     @db.Uuid
  authorId    String?    @db.Uuid
  status      GoalStatus
  /// The goal's progress when the update was posted, 0–100.
  progress    Int
  /// Sanitised rich text; may be empty.
  body        String     @default("")
  createdAt   DateTime   @default(now())

  goal   Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author User? @relation("GoalUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@map("goal_updates")
}

model GoalProject {
  goalId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([goalId, projectId])
  @@index([projectId])
  @@map("goal_projects")
}

/// Membership of a project — the list a private project is private to, and
/// the people a public one shows as "members".
///
/// Always a subset of the workspace's members: the API refuses to add anyone
/// who is not already in the workspace, and drops these rows when someone
/// leaves it. `role` only ever narrows the workspace role (see
/// `ProjectMemberRole`), so a project can never grant more than the workspace
/// did. Workspace OWNER and ADMIN see and manage every project without a row
/// here, which is what keeps a private project recoverable when its admins
/// have all gone.
model ProjectMember {
  projectId   String            @db.Uuid
  userId      String            @db.Uuid
  /// Denormalised so "drop every membership when someone leaves the workspace"
  /// is one indexed statement (see the schema conventions).
  workspaceId String            @db.Uuid
  role        ProjectMemberRole @default(EDITOR)
  /// Who added them. Null for the creator's own row and for backfilled leads.
  addedById   String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("ProjectMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([workspaceId, userId])
  @@index([projectId, role])
  @@map("project_members")
}

/// A named group of people inside a workspace.
///
/// Deliberately *not* a permission boundary: `WorkspaceMember.role` still decides
/// what anyone may do. A team answers "who works on this together", which is an
/// organisational question, and conflating the two produces the classic mess
/// where moving someone between teams silently changes what they can see.
model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(80)
  description String?
  color       String   @default("#6366F1") @db.VarChar(9)
  /// Who runs the team. Nullable because a team can outlast the person leading
  /// it, and the workspace's admins can always step in.
  leadId      String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User?                 @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  projects    Project[]
  goals       Goal[]
  invitations WorkspaceInvitation[]
  messages    TeamMessage[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([leadId])
  @@map("teams")
}

/// Membership of a team. Always a subset of the workspace's members — the API
/// refuses to add anyone who is not already in the workspace, and drops these
/// rows when someone leaves it.
model TeamMember {
  teamId  String   @db.Uuid
  userId  String   @db.Uuid
  addedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Section {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  projectId       String   @db.Uuid
  name            String   @db.VarChar(120)
  /// Fractional ordering: inserting between two rows only rewrites one row.
  position        Float    @default(0)
  /// Optional status applied when a task is moved into this section.
  ///
  /// Null by default, and deliberately so: a section is a workflow column and a
  /// status is task state, and coupling them silently is how "move a card" turns
  /// into an unexplained status change. Opting in makes the coupling a choice.
  defaultStatusId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         Task[]
  tickets       Ticket[]
  defaultStatus StatusDefinition? @relation(fields: [defaultStatusId], references: [id], onDelete: SetNull)
  taskLinks     TaskProject[]     @relation("TaskProjectLinkSection")

  @@index([projectId, position])
  @@index([workspaceId])
  @@map("sections")
}

model Task {
  id                   String          @id @default(uuid(7)) @db.Uuid
  workspaceId          String          @db.Uuid
  projectId            String?         @db.Uuid
  sectionId            String?         @db.Uuid
  parentTaskId         String?         @db.Uuid
  /// A subtask of a ticket rather than of a task. In the ticket's project, in
  /// no section, and gone with the ticket, as a task's subtasks are with it.
  parentTicketId       String?         @db.Uuid
  title                String          @db.VarChar(500)
  description          String?
  /// Legacy enum. Still authoritative until the definition backfill is
  /// verified in production; the FKs below shadow it in the meantime. See
  /// docs/database/project-view-migration.md for the cut-over.
  status               TaskStatus      @default(TODO)
  priority             TaskPriority    @default(NONE)
  /// Set by the backfill, and by every write once definitions are live.
  statusDefinitionId   String?         @db.Uuid
  priorityDefinitionId String?         @db.Uuid
  position             Float           @default(0)
  assigneeId           String?         @db.Uuid
  createdById          String          @db.Uuid
  /// The calendar date, stored at UTC midnight. Every date-only reader
  /// (filters, automations, the calendar) keeps using this column.
  startDate            DateTime?
  /// The exact instant, only when somebody chose a time of day. Null means
  /// "all day". See docs/architecture/task-dates-and-rich-text.md.
  startAt              DateTime?
  dueDate              DateTime?
  dueAt                DateTime?
  completedAt          DateTime?
  estimatedMinutes     Int?
  /// A plain task, a milestone, or an approval — Asana's task types.
  kind                 TaskKind        @default(TASK)
  /// The decision on an approval. Null for every other kind.
  approvalStatus       ApprovalStatus?
  /// "Set to repeat": see `TaskRecurrence` in contracts. Null for a one-off.
  recurrence           Json?
  /// The task this one's completion created, once it has. Unique and set in
  /// the same transaction as the creation, so completing a repeating task
  /// twice — or two writers completing it at once — makes one successor.
  nextOccurrenceId     String?         @unique @db.Uuid
  archivedAt           DateTime?
  /// Set by "Mark as duplicate": the task this one repeats. It is completed,
  /// and its collaborators join the original.
  duplicateOfId        String?         @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section            Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTask         Task?                   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTicket       Ticket?                 @relation("TicketSubtasks", fields: [parentTicketId], references: [id], onDelete: Cascade)
  subtasks           Task[]                  @relation("TaskSubtasks")
  assignee           User?                   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy          User                    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  comments           Comment[]
  attachments        Attachment[]
  followers          Follower[]
  likes              TaskLike[]
  myTaskPlacements   MyTaskPlacement[]
  /// Rows where this task waits on another.
  blockedBy          TaskDependency[]        @relation("DependencyBlocked")
  clockFirings       AutomationClockFiring[]
  /// Rows where another task waits on this one.
  blocking           TaskDependency[]        @relation("DependencyBlocking")
  statusDefinition   StatusDefinition?       @relation(fields: [statusDefinitionId], references: [id], onDelete: SetNull)
  priorityDefinition PriorityDefinition?     @relation(fields: [priorityDefinitionId], references: [id], onDelete: SetNull)
  customFieldValues  TaskCustomFieldValue[]
  projectLinks       TaskProject[]
  timeEntries        TimeEntry[]
  emailRecipients    TaskEmailRecipient[]
  tags               TaskTag[]
  duplicateOf        Task?                   @relation("TaskDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         Task[]                  @relation("TaskDuplicates")
  inboundEmails      InboundEmail[]

  @@index([statusDefinitionId])
  @@index([priorityDefinitionId])
  @@index([workspaceId, status])
  @@index([projectId, sectionId, position])
  @@index([assigneeId, status])
  @@index([workspaceId, dueDate])
  @@index([parentTaskId])
  @@index([parentTicketId])
  @@map("tasks")
}

/// One person's like on one task — Asana's thumbs-up in the pane. The pair is
/// the key, so liking twice is the same row and needs no read-before-write.
model TaskLike {
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_likes")
}

/// "`blockedTask` is waiting on `blockingTask`" — Asana's dependencies.
///
/// Directed, one row per edge, unique per pair. The service refuses an edge
/// that would close a loop, since tasks that each wait on the next can never
/// start. Both ends live in the same workspace; deleting either task takes the
/// edge with it.
model TaskDependency {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @db.Uuid
  blockedTaskId  String   @db.Uuid
  blockingTaskId String   @db.Uuid
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blockedTask  Task      @relation("DependencyBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask Task      @relation("DependencyBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation("DependencyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([blockedTaskId, blockingTaskId])
  @@index([blockingTaskId])
  @@index([workspaceId])
  @@map("task_dependencies")
}

model Ticket {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  projectId   String?        @db.Uuid
  /// Monotonic per workspace; the numeric half of `key`.
  number      Int
  /// Denormalised `${workspace.ticketPrefix}-${number}` for direct lookup.
  key         String         @db.VarChar(24)
  title       String         @db.VarChar(500)
  description String?
  type        TicketType     @default(BUG)
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  severity    TicketSeverity @default(MINOR)
  reporterId  String?        @db.Uuid
  assigneeId  String?        @db.Uuid
  dueDate     DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  /// Where the ticket sits on the project board. Null means nobody has placed
  /// it — every ticket created before tickets could hold a section.
  sectionId   String?        @db.Uuid
  /// Fractional, and shared with the tasks in the same section: one ordering
  /// per column, so a board does not interleave two independent sequences.
  position    Float          @default(0)
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  reporter    User?        @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]
  followers   Follower[]
  subtasks    Task[]       @relation("TicketSubtasks")

  @@unique([workspaceId, number])
  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@index([assigneeId, status])
  @@index([workspaceId, priority])
  @@index([projectId])
  @@index([projectId, sectionId, position])
  @@index([archivedAt])
  @@map("tickets")
}

model Comment {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  authorId    String    @db.Uuid
  body        String
  taskId      String?   @db.Uuid
  ticketId    String?   @db.Uuid
  editedAt    DateTime?
  /// Soft-deleted: threads and activity feeds keep referring to the comment.
  deletedAt   DateTime?
  /// Pinned to the top of its thread. One per thread, enforced in the service.
  pinnedAt    DateTime?
  pinnedById  String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pinnedBy    User?            @relation("CommentPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mentions    CommentMention[]
  attachments Attachment[]
  likes       CommentLike[]

  @@index([taskId, createdAt])
  @@index([ticketId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("comments")
}

/// Who a comment mentions.
///
/// The mention itself lives in `Comment.body` as an `@[Name](uuid)` token, and
/// that body is the source of truth — editing text is what adds or removes a
/// mention. This table is the derived index over it, so "who do I notify" and
/// (later) "what mentions me" are joins rather than a scan with a regex.
///
/// Deleting the user removes the row, but the token stays in the body; the API
/// resolves what it can and the client renders the rest as plain text.
model CommentMention {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  /// Drives an inbox of "comments that mention me".
  @@index([userId, createdAt])
  @@map("comment_mentions")
}

/// A thumbs-up on a comment. One per person; liking twice is still one.
model CommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

/// Who follows a task or a ticket — Asana's collaborators.
///
/// One row per person per item, in the same `taskId | ticketId` shape a
/// comment or an attachment uses. People are added silently when they create,
/// are assigned, comment on or are mentioned in the item, and may add or
/// remove themselves; a manager may remove anyone. Deliberately no tombstone:
/// Asana adds you back the next time you are assigned or comment, so "left"
/// needs no memory. Comment and change notifications fan out to these rows.
model Follower {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  taskId      String?  @db.Uuid
  ticketId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@unique([ticketId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("followers")
}

/// A file held in object storage and pointed at from a task or a ticket.
///
/// The row and the object are written in two steps, because the bytes go
/// straight from the browser to the bucket and never through the API. `PENDING`
/// means a presigned URL was issued; `READY` means the upload was confirmed and
/// the stored object inspected. Only `READY` rows are ever shown or served, so
/// an abandoned upload is invisible rather than a broken link.
model Attachment {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  /// Nullable so removing a person does not delete files the team still needs.
  /// Deliberately unlike `Comment.author`, which cascades: a comment is that
  /// person's words, whereas a file is workspace property they happened to add.
  uploaderId  String?          @db.Uuid
  taskId      String?          @db.Uuid
  ticketId    String?          @db.Uuid
  /// The comment this file was posted with, if any. The file belongs to the
  /// task or ticket either way — it is listed in the panel's strip and counts
  /// against the item's cap — and the comment merely shows it. `SetNull` for
  /// the same reason: removing the words does not remove the file.
  commentId   String?          @db.Uuid
  /// As supplied by the uploader, for display and for the download filename.
  /// Never used to build the storage key.
  filename    String           @db.VarChar(255)
  mimeType    String           @db.VarChar(160)
  /// Declared on create, overwritten at confirm with what storage actually
  /// holds — the client uploads directly, so its claim is not evidence.
  sizeBytes   Int
  objectKey   String           @unique
  status      AttachmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([ticketId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([commentId])
  /// Drives the sweep for uploads that were started and never finished.
  @@index([status, createdAt])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Audit + notifications
// ---------------------------------------------------------------------------

/// Append-only audit trail. Deliberately has no `updatedAt`: a mutable audit
/// record would defeat the purpose.
model ActivityLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  /// Null for system-generated activity (jobs, automations).
  actorId     String?        @db.Uuid
  action      ActivityAction
  entity      ActivityEntity
  entityId    String         @db.Uuid
  summary     String         @db.VarChar(500)
  /// Before/after payload, request id, and anything else worth auditing.
  metadata    Json?
  /// The project the entity belongs to, when it belongs to one. Recorded so
  /// the workspace feed can leave out lines from projects the reader cannot
  /// see; a line about a project itself carries its own id here.
  projectId   String?        @db.Uuid
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, projectId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([actorId])
  @@map("activity_logs")
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  /// Null for account-level notifications that are not workspace-scoped.
  workspaceId  String?          @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String?          @db.VarChar(1000)
  entity       ActivityEntity?
  entityId     String?          @db.Uuid
  actionUrl    String?          @db.VarChar(500)
  readAt       DateTime?
  /// Asana's Archive: out of the inbox, kept for later. Archiving also reads it.
  archivedAt   DateTime?
  /// Asana's Bookmarks: kept at hand whether or not it is archived.
  bookmarkedAt DateTime?
  createdAt    DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, archivedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Project configuration: statuses, priorities, custom fields, saved views
// ---------------------------------------------------------------------------

/// Semantic meaning of a status, preserved when a workspace renames it.
///
/// The name is for people; the category is what code counts. Renaming
/// "In Progress" to "Working" must not stop it registering as active work on a
/// dashboard, which is exactly what happens when rollups match on names.
enum StatusCategory {
  NOT_STARTED
  ACTIVE
  BLOCKED
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// A workspace- or project-defined task status.
///
/// `projectId` is nullable on purpose. A task may have no project at all, so
/// there has to be a workspace-level set for those to point at; a project that
/// wants its own vocabulary defines its own and overrides.
///
/// This does NOT replace `Task.status` yet. The enum column stays authoritative
/// until the backfill is verified — see docs/database/project-view-migration.md.
model StatusDefinition {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  /// Null means the workspace-wide default set.
  projectId   String?        @db.Uuid
  name        String         @db.VarChar(60)
  /// Stable machine name, used by the backfill to map legacy enum values.
  slug        String         @db.VarChar(60)
  category    StatusCategory
  colorToken  String         @default("gray") @db.VarChar(20)
  customColor String?        @db.VarChar(9)
  icon        String?        @db.VarChar(40)
  position    Float          @default(0)
  /// The status a new task gets when none is chosen.
  isDefault   Boolean        @default(false)
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  sections  Section[]

  @@unique([workspaceId, projectId, slug])
  @@index([projectId, position])
  @@index([workspaceId, category])
  @@map("status_definitions")
}

/// A workspace-defined task priority.
///
/// Workspace-scoped rather than per-project: "High" meaning different things in
/// two projects makes cross-project views incoherent.
model PriorityDefinition {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(60)
  slug        String   @db.VarChar(60)
  /// Sort key and the basis of every comparison, so renaming or reordering
  /// never changes what "higher priority" means.
  level       Int
  colorToken  String   @default("gray") @db.VarChar(20)
  customColor String?  @db.VarChar(9)
  icon        String?  @db.VarChar(40)
  position    Float    @default(0)
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, position])
  @@map("priority_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
  SINGLE_SELECT
  MULTI_SELECT
  PEOPLE
  URL
  EMAIL
  /// One to N stars, stored in numberValue.
  RATING
  /// Computed on read from the project's number and date fields; never stored.
  FORMULA
}

/// A user-defined field on a project's tasks.
/// A reusable field definition belonging to a workspace.
///
/// Workspace-scoped, not project-scoped: the same "Risk" field should mean the
/// same thing on every project that uses it, and a definition duplicated per
/// project cannot be reported on across projects. Which projects use it is a
/// separate fact — see `ProjectCustomField`.
///
/// Deliberately no unique constraint on the name. Two projects may each already
/// have a "Status" field with different options, and a constraint would force
/// the migration to merge or rename them; both lose information. Duplicates are
/// allowed and the field picker warns before creating one.
model CustomField {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @db.Uuid
  name        String          @db.VarChar(80)
  description String?
  type        CustomFieldType
  isArchived  Boolean         @default(false)
  /// Type-specific configuration. Validated per type in the service rather than
  /// trusted as arbitrary JSON.
  settings    Json            @default("{}")
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("CustomFieldCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  options   CustomFieldOption[]
  values    TaskCustomFieldValue[]
  projects  ProjectCustomField[]

  @@index([workspaceId, name])
  @@map("custom_fields")
}

/// Which projects use a workspace field, and how it behaves on each.
///
/// `position` and `isRequired` live here rather than on the definition: a field
/// can be the second column on one project and the tenth on another, and
/// required on one without being required everywhere it appears.
model ProjectCustomField {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @db.Uuid
  customFieldId  String   @db.Uuid
  position       Float    @default(0)
  isRequired     Boolean  @default(false)
  /// Asana's "notify task collaborators when this field changes". Per project,
  /// like `isRequired`: whether a change is worth an inbox line is each
  /// project's decision.
  notifyOnChange Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  /// A project uses a field once. Attaching twice is a no-op, not two columns.
  @@unique([projectId, customFieldId])
  @@index([projectId, position])
  @@index([customFieldId])
  @@map("project_custom_fields")
}

/// One choice on a single- or multi-select field.
model CustomFieldOption {
  id            String   @id @default(uuid(7)) @db.Uuid
  customFieldId String   @db.Uuid
  label         String   @db.VarChar(80)
  colorToken    String   @default("gray") @db.VarChar(20)
  customColor   String?  @db.VarChar(9)
  position      Float    @default(0)
  /// Archived rather than deleted, so a task still holding this option keeps a
  /// value that can be rendered instead of a dangling id.
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([customFieldId, position])
  @@map("custom_field_options")
}

/// One task's value for one custom field.
///
/// Typed columns rather than a single JSON blob. The List view has to filter,
/// sort and group by custom fields server-side — large projects must not be
/// filtered in the browser — and a JSON blob is opaque to an index. One
/// nullable column per storage class keeps every value queryable while staying
/// one row per (task, field).
///
/// `optionIds` and `userIds` are arrays so single- and multi-select share one
/// shape; a single-select simply holds at most one.
/// A project a task is in besides its home — Asana's multi-homing. The home
/// stays on `Task.projectId`; each extra project keeps its own section and
/// position, so a task can sit in "Review" on one board and "Q4" on another.
model TaskProject {
  taskId    String   @db.Uuid
  projectId String   @db.Uuid
  sectionId String?  @db.Uuid
  position  Float    @default(0)
  addedById String?  @db.Uuid
  addedAt   DateTime @default(now())

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project  @relation("TaskProjectLinks", fields: [projectId], references: [id], onDelete: Cascade)
  section Section? @relation("TaskProjectLinkSection", fields: [sectionId], references: [id], onDelete: SetNull)

  @@id([taskId, projectId])
  @@index([projectId, sectionId, position])
  @@map("task_projects")
}

/// Time spent on a task — Asana's actual time. A task's actual time is the
/// sum of its entries.
model TimeEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  taskId      String   @db.Uuid
  userId      String?  @db.Uuid
  minutes     Int
  /// The day the time was spent.
  date        DateTime @db.Date
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, date])
  @@index([userId, date])
  @@map("time_entries")
}

model TaskCustomFieldValue {
  taskId        String    @db.Uuid
  customFieldId String    @db.Uuid
  textValue     String?
  numberValue   Decimal?  @db.Decimal(20, 6)
  dateValue     DateTime?
  booleanValue  Boolean?
  optionIds     String[]  @db.Uuid
  userIds       String[]  @db.Uuid
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  updatedBy   User?       @relation("CustomFieldValueUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// One value per task per field — the composite key is the constraint.
  @@id([taskId, customFieldId])
  @@index([customFieldId])
  @@index([customFieldId, textValue])
  @@index([customFieldId, numberValue])
  @@index([customFieldId, dateValue])
  @@map("task_custom_field_values")
}

enum ProjectViewType {
  LIST
  BOARD
  CALENDAR
  TIMELINE
  DASHBOARD
}

/// Who a saved view belongs to.
enum ProjectViewScope {
  /// Visible to every project member.
  PROJECT
  /// Visible only to its owner.
  PERSONAL
}

/// A saved way of looking at a project's tasks.
///
/// A view is presentation, never a copy of task data: List and Board read the
/// same tasks through the same API, and deleting a view loses an arrangement
/// rather than any work.
model ProjectView {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  projectId   String           @db.Uuid
  name        String           @db.VarChar(80)
  type        ProjectViewType
  scope       ProjectViewScope @default(PROJECT)
  /// Required for PERSONAL, null for PROJECT.
  ownerUserId String?          @db.Uuid
  isDefault   Boolean          @default(false)
  isFavorite  Boolean          @default(false)
  position    Float            @default(0)
  /// Columns, widths, pinning, density, grouping, filters and sorts.
  ///
  /// One validated JSON document rather than four child tables: it is read and
  /// written whole and never queried by its contents, so splitting it would
  /// turn every view load into a set of joins for no gain. The service
  /// validates it against a Zod schema on write, so it is not free-form.
  settings    Json             @default("{}")
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?     @relation("ProjectViewOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ProjectViewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, type])
  @@index([projectId, ownerUserId])
  @@map("project_views")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

enum AutomationRuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
  ARCHIVED
}

enum AutomationNodeType {
  TRIGGER
  CONDITION
  ACTION
  BRANCH
  DELAY
}

enum AutomationExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIALLY_FAILED
  /// Stopped before running: a loop guard, a depth limit, or a rule that was
  /// paused between the event firing and the job being picked up.
  SKIPPED
}

/// A workflow rule on a project.
///
/// Only `ACTIVE` rules run. Everything else — draft, paused, disabled, archived
/// — is a rule that exists but does nothing, which is what makes pausing a
/// misbehaving rule safe and instant.
model AutomationRule {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  workspaceId        String                 @db.Uuid
  projectId          String                 @db.Uuid
  name               String                 @db.VarChar(120)
  description        String?
  status             AutomationRuleStatus   @default(DRAFT)
  /// Denormalised from the trigger node so matching an event is one indexed
  /// query rather than a join through every rule's nodes.
  triggerType        String                 @db.VarChar(60)
  /// Trigger scoping — the section id for TASK_MOVED_TO_SECTION, and so on.
  triggerConfig      Json                   @default("{}")
  version            Int                    @default(1)
  /// How the name is maintained. See `AutomationRuleNameMode`.
  nameMode           AutomationRuleNameMode @default(MANUAL)
  /// The version being edited, and the one running. Different rows on purpose:
  /// editing a live rule must not change what it does until somebody publishes.
  draftVersionId     String?                @unique @db.Uuid
  publishedVersionId String?                @unique @db.Uuid
  /// Whether this rule may run on an event another rule caused.
  ///
  /// Rules legitimately cascade — one moves a task, another reacts to the move
  /// — but a rule meant to answer only what people do should say so, and the
  /// depth limit is a backstop rather than an expression of intent. Defaults to
  /// true so every existing rule keeps behaving exactly as it did.
  allowChaining      Boolean                @default(true)
  createdById        String?                @db.Uuid
  /// Set when a bundle wrote this rule; the bundle replaces it on refresh.
  bundleId           String?                @db.Uuid
  publishedAt        DateTime?
  /// For a SCHEDULED_TIME rule, the scheduled moment last run. The clock runs
  /// any later occurrence that has arrived, once, and moves this forward.
  scheduleCursor     DateTime?
  lastRunAt          DateTime?
  lastRunStatus      String?                @db.VarChar(30)
  runCount           Int                    @default(0)
  failureCount       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User?                   @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  nodes             AutomationNode[]
  executions        AutomationExecution[]
  statusDrafts      ProjectStatusDraft[]
  delayedRuns       AutomationDelayedRun[]
  webhookDeliveries WebhookDelivery[]
  versions          AutomationRuleVersion[] @relation("RuleVersions")
  draftVersion      AutomationRuleVersion?  @relation("RuleDraft", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion  AutomationRuleVersion?  @relation("RulePublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  savedAsTemplates  AutomationTemplate[]    @relation("TemplateSourceRule")
  clockFirings      AutomationClockFiring[]
  bundle            Bundle?                 @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  /// The matcher's query: active rules for a project on a given trigger.
  @@index([projectId, status, triggerType])
  @@index([bundleId])
  @@index([workspaceId, status])
  @@map("automation_rules")
}

/// One step in a rule.
///
/// A node tree rather than separate Trigger/Condition/Action tables. The two
/// models cannot coexist without one of them being a lie, and a tree is what a
/// visual builder edits — branches need a parent and an ordinal, which normalised
/// tables would have to reinvent anyway.
/// How a rule's name is maintained.
enum AutomationRuleNameMode {
  /// Derived from the trigger, and re-derived when the trigger changes.
  AUTO
  /// Somebody typed it. Never overwritten.
  MANUAL
}

/// Which of a rule's ordered alternatives a branch is.
enum AutomationBranchType {
  /// The first one, with the rule's opening condition.
  PRIMARY
  /// A further alternative, with its own condition.
  OTHERWISE_IF
  /// The fallback. No condition, last, at most one.
  OTHERWISE
}

/// Whether every condition in a group must hold, or any one of them.
enum ConditionGroupOperator {
  ALL
  ANY
}

/// One editable or published state of a rule.
///
/// A rule points at a draft and at a published version, and they are different
/// rows — which is what lets somebody edit a live rule without the edits taking
/// effect. Publishing does not mutate what is running; it points the rule at a
/// new row.
model AutomationRuleVersion {
  id      String @id @default(uuid(7)) @db.Uuid
  ruleId  String @db.Uuid
  /// Monotonic within a rule. The draft carries the next number.
  version Int

  /// The trigger, denormalised onto the version rather than a table of one row.
  triggerType   String @db.VarChar(60)
  triggerConfig Json   @default("{}")

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rule        AutomationRule     @relation("RuleVersions", fields: [ruleId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("AutomationVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  branches    AutomationBranch[]
  draftOf     AutomationRule?    @relation("RuleDraft")
  publishedOf AutomationRule?    @relation("RulePublished")

  @@unique([ruleId, version])
  @@index([ruleId])
  @@map("automation_rule_versions")
}

/// One of a rule's ordered alternatives.
///
/// Ordered by an integer rather than by parentage, so moving a branch is one
/// column write instead of rewriting a chain of links — and so "which branch is
/// third" is a question the database can answer.
model AutomationBranch {
  id            String               @id @default(uuid(7)) @db.Uuid
  ruleVersionId String               @db.Uuid
  type          AutomationBranchType
  position      Int

  ruleVersion    AutomationRuleVersion     @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  conditionGroup AutomationConditionGroup?
  actions        AutomationAction[]

  @@unique([ruleVersionId, position])
  @@index([ruleVersionId])
  @@map("automation_branches")
}

/// The conditions a branch is chosen by, and how they combine.
model AutomationConditionGroup {
  id       String                 @id @default(uuid(7)) @db.Uuid
  branchId String                 @unique @db.Uuid
  operator ConditionGroupOperator @default(ALL)

  branch     AutomationBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  conditions AutomationCondition[]

  @@map("automation_condition_groups")
}

/// One comparison inside a group.
model AutomationCondition {
  id               String @id @default(uuid(7)) @db.Uuid
  conditionGroupId String @db.Uuid
  /// What is being compared — `status`, `sectionId`, `customField:<id>`.
  fieldKey         String @db.VarChar(120)
  operator         String @db.VarChar(40)
  /// Shape depends on the operator: a scalar, or a list for the `one of` forms.
  value            Json   @default("null")
  position         Int

  group AutomationConditionGroup @relation(fields: [conditionGroupId], references: [id], onDelete: Cascade)

  @@unique([conditionGroupId, position])
  @@index([conditionGroupId])
  @@map("automation_conditions")
}

/// One thing a branch does, in the order it does it.
model AutomationAction {
  id            String @id @default(uuid(7)) @db.Uuid
  branchId      String @db.Uuid
  actionType    String @db.VarChar(60)
  /// Validated per action type before it is written — never arbitrary JSON.
  configuration Json   @default("{}")
  position      Int

  branch AutomationBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, position])
  @@index([branchId])
  @@map("automation_actions")
}

model AutomationNode {
  id            String             @id @default(uuid(7)) @db.Uuid
  ruleId        String             @db.Uuid
  nodeType      AutomationNodeType
  /// The specific trigger, condition or action, e.g. `ASSIGN_USER`.
  subtype       String             @db.VarChar(60)
  configuration Json               @default("{}")
  positionX     Float              @default(0)
  positionY     Float              @default(0)
  parentNodeId  String?            @db.Uuid
  /// Which arm of a branch this hangs off.
  branchKey     String?            @db.VarChar(40)
  position      Float              @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  rule       AutomationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  parentNode AutomationNode?  @relation("NodeChildren", fields: [parentNodeId], references: [id], onDelete: Cascade)
  children   AutomationNode[] @relation("NodeChildren")

  @@index([ruleId, position])
  @@index([parentNodeId])
  @@map("automation_nodes")
}

/// A rule saved to the workspace's library, to be started from again.
///
/// A snapshot of a rule's graph rather than a link to the rule. The rule goes
/// on being edited, paused and archived, and a template that changed under
/// everyone who had already used it would be a rule nobody wrote. Workspace-
/// scoped, because reuse across projects is the whole point of saving one.
///
/// The graph is stored as JSON in the shape `POST /automations` accepts, not as
/// node rows: a template is never executed, validated in place or edited — it
/// is only ever read whole and written into a new draft — so a second copy of
/// the node table would be structure with no query to serve.
model AutomationTemplate {
  id            String  @id @default(uuid(7)) @db.Uuid
  workspaceId   String  @db.Uuid
  name          String  @db.VarChar(120)
  description   String?
  /// Denormalised from the trigger node, as on the rule, so the library can be
  /// listed and searched by trigger without parsing every graph.
  triggerType   String  @db.VarChar(60)
  triggerConfig Json    @default("{}")
  /// The node tree, ids and parentage included. Ids are the source rule's and
  /// are mapped to fresh ones on every apply, exactly as a builder save is.
  nodes         Json    @default("[]")
  /// The names behind the project-scoped ids the graph carries — sections,
  /// statuses, custom fields and their options. Applying the template in
  /// another project matches these by name, and keeping them here means that
  /// still works after the source project renamed, deleted or archived them.
  references    Json    @default("{}")
  allowChaining Boolean @default(true)

  /// Where it came from. Both null out rather than taking the template with
  /// them: the library is the point of saving, and a rule being deleted is
  /// often exactly when its template is wanted.
  sourceRuleId    String? @db.Uuid
  sourceProjectId String? @db.Uuid
  createdById     String? @db.Uuid

  /// How often it has been applied. A library sorts and prunes by this.
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRule    AutomationRule? @relation("TemplateSourceRule", fields: [sourceRuleId], references: [id], onDelete: SetNull)
  sourceProject Project?        @relation("TemplateSourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("AutomationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, name])
  @@index([sourceRuleId])
  @@index([sourceProjectId])
  @@map("automation_templates")
}

/// A date trigger that has fired for one task.
///
/// "Due in two days" holds for two days, and the clock looks every minute; this
/// is what makes it announce each crossing once. Keyed on the moment the window
/// opened, so a task whose date moves can fire again for its new date.
model AutomationClockFiring {
  id        String   @id @default(uuid(7)) @db.Uuid
  ruleId    String   @db.Uuid
  taskId    String   @db.Uuid
  /// When the trigger's condition began to hold for this task.
  firedFor  DateTime
  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([ruleId, taskId, firedFor])
  @@index([taskId])
  @@map("automation_clock_firings")
}

/// One run of one rule.
model AutomationExecution {
  id            String                    @id @default(uuid(7)) @db.Uuid
  workspaceId   String                    @db.Uuid
  projectId     String                    @db.Uuid
  ruleId        String                    @db.Uuid
  status        AutomationExecutionStatus @default(RUNNING)
  triggerType   String                    @db.VarChar(60)
  /// What the run was about — usually a task.
  entityType    String?                   @db.VarChar(40)
  entityId      String?                   @db.Uuid
  /// Who or what caused the triggering change. Null when a rule caused it.
  actorId       String?                   @db.Uuid
  /// Shared by every execution descended from one original user action, which
  /// is what makes a loop detectable rather than merely suspected.
  correlationId String                    @db.Uuid
  /// How many rules deep this is. The original action is 0.
  depth         Int                       @default(0)
  /// Set when conditions did not match, so a no-op is distinguishable from a
  /// failure in the history.
  skippedReason String?                   @db.VarChar(200)
  error         String?
  durationMs    Int?
  startedAt     DateTime                  @default(now())
  finishedAt    DateTime?

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  logs      AutomationExecutionLog[]

  @@index([ruleId, startedAt])
  @@index([projectId, status])
  @@index([correlationId])
  @@map("automation_executions")
}

/// One action attempt inside an execution.
///
/// Before and after values are recorded per action rather than per run: a rule
/// with four actions where the third failed is only diagnosable if each is
/// accounted for separately.
model AutomationExecutionLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  executionId String   @db.Uuid
  nodeId      String?  @db.Uuid
  nodeType    String   @db.VarChar(30)
  subtype     String   @db.VarChar(60)
  succeeded   Boolean
  message     String?  @db.VarChar(500)
  beforeValue Json?
  afterValue  Json?
  createdAt   DateTime @default(now())

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("automation_execution_logs")
}

/// A project's key resource — Asana's Overview "Key resources": a link the
/// whole project should have to hand (the brief, a drive folder, the spec).
model ProjectResource {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  title       String   @db.VarChar(120)
  url         String   @db.VarChar(2048)
  position    Float    @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProjectResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@map("project_resources")
}

/// A project's Note tab — Asana's project page: one rich-text document the
/// whole project reads and its editors write, saved as they type.
model ProjectNote {
  projectId   String   @id @db.Uuid
  workspaceId String   @db.Uuid
  /// Sanitised rich text.
  body        String   @default("")
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ProjectNoteEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("project_notes")
}

/// A project's email address — Asana's "Add tasks via email". Mail sent to
/// `<token>@<INBOUND_EMAIL_DOMAIN>` becomes a task here, and mail sent to
/// `<token>+<task>@…` (the reply address of an update) a comment on that task.
model ProjectEmailInbox {
  id               String   @id @default(uuid(7)) @db.Uuid
  workspaceId      String   @db.Uuid
  projectId        String   @unique @db.Uuid
  /// Lowercase hex: mail systems may fold the case of an address.
  token            String   @unique @db.VarChar(32)
  /// Off, mail to the address is dropped.
  isActive         Boolean  @default(true)
  /// Where new tasks land; the project's first section when null.
  sectionId        String?  @db.Uuid
  /// MEMBERS: only workspace members' mail is taken. ANYONE: anyone's, credited
  /// to whoever set the address up when the sender has no account.
  acceptFrom       String   @default("MEMBERS") @db.VarChar(16)
  /// Members on To and CC become the task's collaborators.
  addCollaborators Boolean  @default(true)
  /// Addresses on From, To and CC that are not members hear about comments.
  sendUpdates      Boolean  @default(true)
  receivedCount    Int      @default(0)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_email_inboxes")
}

/// One message that reached a project's address, and what became of it. The
/// Message-ID makes a provider's retry a no-op instead of a second task.
model InboundEmail {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  messageId   String?  @db.VarChar(998)
  fromAddress String   @db.VarChar(320)
  subject     String   @db.VarChar(500)
  /// TASK_CREATED, COMMENTED or REJECTED.
  outcome     String   @db.VarChar(16)
  reason      String?  @db.VarChar(300)
  taskId      String?  @db.Uuid
  receivedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([projectId, messageId])
  @@index([projectId, receivedAt])
  @@map("inbound_emails")
}

/// Someone outside the workspace who was on a task's email thread, and so is
/// sent its comments — replying to one adds theirs.
model TaskEmailRecipient {
  taskId    String   @db.Uuid
  address   String   @db.VarChar(320)
  /// The project whose address the thread came through: its reply address.
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, address])
  @@map("task_email_recipients")
}

/// A private calendar link — Asana's "Sync to calendar". Calendar apps fetch
/// `/calendar/<token>.ics` with no account, so the token is the credential: it
/// only reads, as its owner may see things now, and a reset replaces it.
model CalendarFeed {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @db.Uuid
  userId        String    @db.Uuid
  /// Null: the owner's My Tasks. Otherwise that project's tasks.
  projectId     String?   @db.Uuid
  token         String    @unique @db.VarChar(64)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@map("calendar_feeds")
}

/// A status update on a portfolio as a whole — beside the per-project ones its
/// Progress tab rolls up. The newest is the portfolio's status.
model PortfolioStatusUpdate {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @db.Uuid
  portfolioId String             @db.Uuid
  authorId    String?            @db.Uuid
  status      ProjectStatusValue
  title       String             @db.VarChar(200)
  summary     String?
  nextSteps   String?
  createdAt   DateTime           @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  author    User?     @relation("PortfolioStatusAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([portfolioId, createdAt])
  @@map("portfolio_status_updates")
}

/// A rule run waiting at a Wait step. The clock publishes `event` again, aimed
/// at the rule and marked to resume from `nodeId`, once `runAt` has passed.
model AutomationDelayedRun {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  ruleId      String   @db.Uuid
  /// The Wait step the run resumes after.
  nodeId      String   @db.Uuid
  runAt       DateTime
  /// The event the run started from, to be published again.
  event       Json
  /// PENDING until the clock takes it; DONE once republished; CANCELLED when
  /// the rule had stopped by then.
  status      String   @default("PENDING") @db.VarChar(16)
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("automation_delayed_runs")
}

/// A link to set a new password: an hour, once. Only the hash is kept, and
/// asking for a new link replaces any unused one.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 hex of the token in the link.
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// A "confirm your e-mail address" link. Bound to the address it was sent to,
/// so a link mailed before an address change cannot vouch for the new one.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  email     String    @db.VarChar(254)
  /// SHA-256 hex of the token in the link.
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}
