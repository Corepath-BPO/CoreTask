# =============================================================================
# CoreTask — environment template
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Every variable below is validated at API start-up (api/src/config/env.schema.ts).
# The process exits with a descriptive error if a required value is missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Public origin of the web client. Used for CORS allowlist + e-mail links.
# Comma-separate to allow several origins.
WEB_URL=http://localhost:5173

# Public origin of the API. Consumed by the web client at build time.
API_URL=http://localhost:3000
API_PORT=3000

# Production domains (coretask.org). Each public origin is its own image:
#   coretask.org       website/  marketing site    coretask/website
#   app.coretask.org   webapp/   the app           coretask/webapp
#   api.coretask.org   api/      REST, WebSocket, OAuth/SSO/Slack callbacks
# so production sets:
#   WEB_URL=https://app.coretask.org
#   API_URL=https://api.coretask.org
#   VITE_API_URL=https://api.coretask.org/api/v1
#   VITE_WS_URL=https://api.coretask.org
#   COOKIE_DOMAIN=     (empty: the refresh-token cookie stays on api.coretask.org)
#   MAIL_FROM_ADDRESS=noreply@coretask.org
#   MAIL_REPLY_TO=support@coretask.org
# app. and api. share a site, so the SameSite=lax cookie still travels with the
# app's requests, and the API's CORS allowlist (WEB_URL) admits the app.
#
# The four mailboxes:
#   hello@coretask.org     early access and sales — the website's buttons
#   support@coretask.org   help — the app's account menu, replies to app e-mail
#   noreply@coretask.org   the sender of every e-mail the app sends
#   official@coretask.org  official and business enquiries — the website footer
# The website and webapp builds default to these; the API needs the two above.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=coretask
POSTGRES_PASSWORD=coretask_dev_password
POSTGRES_DB=coretask
POSTGRES_PORT=5432

# Host-side URL (running the API outside Docker).
# Inside Docker Compose the host is `coretask-postgres` — see docker-compose.yml.
DATABASE_URL=postgresql://coretask:coretask_dev_password@localhost:5432/coretask?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, BullMQ queues, Socket.IO adapter)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# BullMQ key prefix. The API and the worker must share it.
QUEUE_PREFIX=bull

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# DEVELOPMENT VALUES ONLY. Generate real secrets for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie domain for the refresh-token cookie. Leave empty for localhost.
COOKIE_DOMAIN=
# Cookie name is fixed; these control the security flags.
# `secure` is forced on when NODE_ENV=production.
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# Applies only to the endpoints that accept a password (login, register), where
# the point is to slow guessing. `/auth/refresh` and `/auth/logout` sit on
# RATE_LIMIT_MAX instead — they carry no credentials, and every open tab
# refreshes on load, so a strict ceiling there just signs people out.
#
# Raise this (100 is plenty) while running the browser e2e suite: it signs in
# more often in a minute than a person ever would. See docs/api/authentication.md.
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Object storage (RustFS locally, Cloudflare R2 in production)
# -----------------------------------------------------------------------------
# These values are the dev stack's RustFS; nothing here needs an R2 account.
# The Docker API and worker always talk to coretask-storage:9000 on the compose
# network, and STORAGE_ENDPOINT is for the API run on the host.
#
# Production (docker-compose.prod.yml) uses R2. Put these in the server's own
# .env or secret store, never in this file:
#   STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#     (a bucket in the EU jurisdiction: https://<account_id>.eu.r2.cloudflarestorage.com)
#   STORAGE_PUBLIC_ENDPOINT=     (empty: the browser uses the same address)
#   STORAGE_REGION=auto
#   STORAGE_BUCKET=<the bucket's name>
#   STORAGE_ACCESS_KEY=<R2 API token: Access Key ID>
#   STORAGE_SECRET_KEY=<R2 API token: Secret Access Key>
#   STORAGE_FORCE_PATH_STYLE=true
# The token needs "Object Read & Write" on that one bucket. The bucket stays
# private: files are served on short-lived presigned URLs. Its CORS policy is
# set once in the Cloudflare dashboard, and docs/architecture/docker.md has the
# JSON. Check a bucket from an env file holding the values above with
#   pnpm --filter @coretask/api storage:check <env file>
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=coretask
STORAGE_ACCESS_KEY=coretask_minio
STORAGE_SECRET_KEY=coretask_minio_dev_password
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# E-mail (Microsoft Graph)
# -----------------------------------------------------------------------------
# The one e-mail transport. Leave the block empty and e-mail is written to the
# log instead of sent, which is all local development needs.
#
# Entra ID app registration using the client-credentials flow. It needs the
# APPLICATION permission `Mail.Send` with admin consent granted — the delegated
# permission of the same name will not work, because a queue worker has no
# signed-in user.
#
# All four of TENANT_ID, CLIENT_ID, CLIENT_SECRET and MAIL_FROM_ADDRESS must be
# present together; the API refuses to start on a partial configuration rather
# than falling back to the log transport and looking like it is delivering mail.
#
# MAIL_FROM_ADDRESS must be a real mailbox in the tenant. Mail is sent as it and
# a copy lands in its Sent Items.
#
# CLIENT_SECRET is a secret: keep it in .env, never in this file, and never in
# an image or a compose file committed to the repository.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MAIL_FROM_ADDRESS=
# The display name beside that address in an inbox. Without it Exchange uses the
# mailbox's own directory display name, which is usually the tenant's name and
# not the product's. Defaults to CoreTask.
MAIL_FROM_NAME=CoreTask
# Where replies go when a message names no reply address of its own
# (invitations, password resets…). Optional. Task update e-mails keep theirs,
# which threads the answer back into the task.
MAIL_REPLY_TO=
MAIL_CONNECTION_TIMEOUT_MS=15000

# Email to a project (Customize › Emails). Mail for <token>@INBOUND_EMAIL_DOMAIN
# is received by a mail provider — Postmark, SendGrid Inbound Parse, Mailgun —
# and posted to <API_URL>/api/v1/inbound/email, with INBOUND_EMAIL_SECRET as the
# password of HTTP Basic auth (https://inbound:<secret>@host/…) or in an
# X-Inbound-Secret header. Point the domain's MX record at the provider. Both
# or neither; the secret is at least 16 characters.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# -----------------------------------------------------------------------------
# AI steps in rules (Anthropic)
# -----------------------------------------------------------------------------
# "Use AI…" and "Check with AI" send the task a rule ran on — its title,
# description, fields, recent comments and subtasks — to Anthropic's Messages
# API. Leave ANTHROPIC_API_KEY empty to keep both steps greyed out.
#
# The key is a secret: keep it in .env, never in this file, and never in an
# image or a compose file committed to the repository.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# The CoreTask Slack app — docs/integrations/slack.md
# -----------------------------------------------------------------------------
# From the app's Basic Information page at api.slack.com/apps: all three or
# none. Without them Integrations › Slack says Slack is not set up. Slack must
# reach <API_URL>/api/v1/integrations/slack/… over public HTTPS (a tunnel while
# there is no domain); installs return to <WEB_URL>/integrations/slack/callback.
#
# Secrets: keep them in .env only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Importing from Asana — docs/integrations/asana-import.md
# -----------------------------------------------------------------------------
# A personal access token (Asana › Settings › Apps › Developer apps) and the
# gid of the Asana workspace it reads. Only people whose e-mail is a member of
# that Asana workspace may start an import. The importer only ever reads Asana.
#
# Secrets: keep them in .env only.
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_ID=
# Optional pacing: Asana allows 1,500 requests a minute on paid plans, 150 on free.
# ASANA_MAX_REQUESTS_PER_MINUTE=1200
# ASANA_CONCURRENCY=10

# -----------------------------------------------------------------------------
# Sign-in and account security
# -----------------------------------------------------------------------------
# Days a new account may be used before its e-mail address has to be
# confirmed; after that only confirming, changing or resending works.
EMAIL_VERIFICATION_GRACE_DAYS=7

# "Sign in with Google" / "Sign in with Microsoft" (OpenID Connect). Register
# the redirect URI <API_URL>/api/v1/auth/sso/google/callback (or .../microsoft/
# callback). Client id and secret both, or neither; without them the button is
# hidden. MICROSOFT_SSO_TENANT: common, organizations, consumers or a tenant id.
# A Microsoft sign-in is matched to an existing CoreTask account by address
# only when Microsoft vouches for the address: add the optional `xms_edov`
# claim to the app registration's ID token.
#
# Secrets: keep them in .env only.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
MICROSOFT_SSO_TENANT=common

# -----------------------------------------------------------------------------
# Web client (Vite) — only VITE_* variables reach the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
# Other hosts this dev server answers on, each with its own API origin, as
# `host=origin`, comma-separated. Staging through the tunnel sets
#   VITE_API_ORIGINS_BY_HOST=staging.coretask.org=https://staging-api.coretask.org
VITE_API_ORIGINS_BY_HOST=
VITE_APP_NAME=CoreTask
# Behind "Contact support" in the account menu.
VITE_SUPPORT_EMAIL=support@coretask.org
WEB_PORT=5173
# The marketing website in the Docker dev stack.
WEBSITE_PORT=3200

# -----------------------------------------------------------------------------
# Development seed (development only — never enable in production)
# -----------------------------------------------------------------------------
SEED_USER_EMAIL=demo@coretask.dev
SEED_USER_PASSWORD=CoreTask!2024

# -----------------------------------------------------------------------------
# Outbound webhooks (Integrations → Webhooks)
# -----------------------------------------------------------------------------
# Deliveries retry with exponential backoff from the base delay (30 s, 1 m, 2 m,
# 4 m, 8 m by default) and an endpoint switches itself off after
# WEBHOOK_AUTO_DISABLE_AFTER consecutive final failures.
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=30000
WEBHOOK_AUTO_DISABLE_AFTER=20
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Allow endpoints on localhost / private networks. Keep false unless the tool
# receiving the webhooks (n8n, for instance) runs on the same machine or LAN.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# Encrypts signing secrets at rest. Required in production (32+ characters);
# derived from JWT_ACCESS_SECRET when empty elsewhere. Losing it means rotating
# every endpoint's secret.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Staging: this dev stack on the internet through a Cloudflare Tunnel
# -----------------------------------------------------------------------------
# The token of a tunnel created in Cloudflare Zero Trust (Networks > Tunnels).
# Empty leaves the tunnel off. Start it with the `tunnel` profile; the rest of
# the staging values are in docs/architecture/staging.md.
CLOUDFLARE_TUNNEL_TOKEN=
