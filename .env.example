# =============================================================================
# CoreTask — environment template
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Every variable below is validated at API start-up (api/src/config/env.schema.ts).
# The process exits with a descriptive error if a required value is missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Public origin of the web client. Used for CORS allowlist + e-mail links.
# Comma-separate to allow several origins.
WEB_URL=http://localhost:5173

# Public origin of the API. Consumed by the web client at build time.
API_URL=http://localhost:3000
API_PORT=3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=coretask
POSTGRES_PASSWORD=coretask_dev_password
POSTGRES_DB=coretask
POSTGRES_PORT=5432

# Host-side URL (running the API outside Docker).
# Inside Docker Compose the host is `coretask-postgres` — see docker-compose.yml.
DATABASE_URL=postgresql://coretask:coretask_dev_password@localhost:5432/coretask?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, BullMQ queues, Socket.IO adapter)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# DEVELOPMENT VALUES ONLY. Generate real secrets for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie domain for the refresh-token cookie. Leave empty for localhost.
COOKIE_DOMAIN=
# Cookie name is fixed; these control the security flags.
# `secure` is forced on when NODE_ENV=production.
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# Applies only to the endpoints that accept a password (login, register), where
# the point is to slow guessing. `/auth/refresh` and `/auth/logout` sit on
# RATE_LIMIT_MAX instead — they carry no credentials, and every open tab
# refreshes on load, so a strict ceiling there just signs people out.
#
# Raise this (100 is plenty) while running the browser e2e suite: it signs in
# more often in a minute than a person ever would. See docs/api/authentication.md.
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Object storage (MinIO locally, S3-compatible in production)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=coretask
STORAGE_ACCESS_KEY=coretask_minio
STORAGE_SECRET_KEY=coretask_minio_dev_password
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_MB=25
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
# Three transports, chosen in this order:
#
#   1. Microsoft Graph, when the MICROSOFT_GRAPH_* block below is filled in
#   2. SMTP, when SMTP_HOST is set
#   3. The development transport, which writes the rendered message to the log
#
# Point SMTP_HOST at a local catcher (Mailpit/Mailhog on 1025) when you want to
# inspect real mail without sending any.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="CoreTask <no-reply@coretask.local>"

# -----------------------------------------------------------------------------
# E-mail (Microsoft Graph)
# -----------------------------------------------------------------------------
# Entra ID app registration using the client-credentials flow. It needs the
# APPLICATION permission `Mail.Send` with admin consent granted — the delegated
# permission of the same name will not work, because a queue worker has no
# signed-in user.
#
# All four of TENANT_ID, CLIENT_ID, CLIENT_SECRET and MAIL_FROM_ADDRESS must be
# present together; the API refuses to start on a partial configuration rather
# than falling back to the log transport and looking like it is delivering mail.
#
# MAIL_FROM_ADDRESS must be a real mailbox in the tenant. Mail is sent as it and
# a copy lands in its Sent Items.
#
# CLIENT_SECRET is a secret: keep it in .env, never in this file, and never in
# an image or a compose file committed to the repository.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MAIL_FROM_ADDRESS=
MAIL_CONNECTION_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Web client (Vite) — only VITE_* variables reach the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_APP_NAME=CoreTask
WEB_PORT=5173

# -----------------------------------------------------------------------------
# Development seed (development only — never enable in production)
# -----------------------------------------------------------------------------
SEED_USER_EMAIL=demo@coretask.dev
SEED_USER_PASSWORD=CoreTask!2024
